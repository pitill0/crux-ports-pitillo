# Description: Real-time graphical programming environment for audio, video, and graphical processing
# URL: http://puredata.info/
# Maintainer: Victor Martinez, pitillo at crux-arm dot nu
# Depends on: alsa-lib 

name=pd
version=0.56
release=5
source=(http://msp.ucsd.edu/Software/$name-$version-$release.src.tar.gz)

build() {
  cd $name-$version-$release
  ./autogen.sh
  ./configure --prefix=/usr \
              --disable-locales
  make
  make prefix=$PKG/usr install
  rm $PKG/usr/share/pd/{README.txt,*/README.txt}
}
