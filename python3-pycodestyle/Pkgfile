# Description: tool to check your Python code against some of the style conventions in PEP 8 
# URL: https://pypi.org/project/pycodestyle
# Maintainer: Victor Martinez, pitillo at crux-arm dot nu
# Depends on: python3-wheel

name=python3-pycodestyle
version=2.14.0
release=1
source=(https://pypi.org/packages/source/p/pycodestyle/pycodestyle-$version.tar.gz)

build() {
  cd pycodestyle-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
