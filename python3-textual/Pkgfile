# Description: Build cross-platform user interfaces with a simple Python API
# URL: https://github.com/Textualize/textual
# Maintainer: Victor Martinez, pitillo at crux-arm dot nu 
# Depends on: python3-typing_extensions python3-platformdirs python3-rich

name=python3-textual
version=8.2.7
release=1
source=(https://pypi.org/packages/source/t/textual/textual-$version.tar.gz)

build() {
  cd textual-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
