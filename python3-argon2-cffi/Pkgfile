# Description: Secure Argon2 password hashing library for Python
# URL: https://github.com/hynek/argon2-cffi
# Maintainer: Victor Martinez, pitillo at crux-arm dot nu
# Depends on: python3-argon2-cffi-bindings

name=python3-argon2-cffi
version=25.1.0
release=1
source=(https://files.pythonhosted.org/packages/source/a/argon2-cffi/argon2_cffi-${version}.tar.gz)

build() {
  cd argon2_cffi-${version}

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --compile-bytecode 2 \
    --destdir=${PKG} dist/*.whl
}
