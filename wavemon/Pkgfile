# Description: Ncurses-based monitoring application for wireless network devices
# URL: http://eden-feed.erg.abdn.ac.uk/wavemon/
# Maintainer: Victor Martinez, pitillo at crux-arm dot nu
# Depends on: ncurses libnl-cli

name=wavemon
version=0.9.7
release=1
source=(https://github.com/uoaerg/wavemon/archive/v${version}/$name-v$version.tar.gz)

build() {
  cd $name-$version

  export CFLAGS="$CFLAGS $(pkg-config --cflags libnl-3.0 libnl-genl-3.0) -D_XOPEN_SOURCE_EXTENDED=1"
  export LIBS="$LIBS $(pkg-config --libs libnl-3.0 libnl-genl-3.0)"

  ./configure --prefix=/usr

  make

  make prefix=$PKG/usr install
  rm -rf ${PKG}/usr/share/$name
}
