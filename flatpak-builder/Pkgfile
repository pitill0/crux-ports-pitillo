# Description: tool for building flatpaks from sources.
# URL: https://flatpak.org
# Maintainer: Victor Martinez, pitillo at crux-arm dot nu
# Depends on: flatpak debugedit

name=flatpak-builder
version=1.4.8
release=1
source=(https://github.com/flatpak/flatpak-builder/releases/download/$version/$name-$version.tar.xz)

build() {
  meson setup $name-$version build \
    --prefix=/usr \
    --libexecdir=lib \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true 
  meson compile -C build
  DESTDIR=$PKG meson install -C build

  rm -fr $PKG/usr/lib/{systemd,sysusers.d}
  rm -fr $PKG/usr/share/{fish,locale,doc}
}
