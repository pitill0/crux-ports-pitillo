# Description: improved colored diff
# URL: https://pypi.org/project/icdiff
# Maintainer: Victor Martinez, pitillo at crux-arm dot nu
# Depends on: python3-wheel

name=python3-icdiff
version=2.0.7
release=1
source=(https://pypi.org/packages/source/i/icdiff/icdiff-$version.tar.gz)

build() {
  cd icdiff-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
