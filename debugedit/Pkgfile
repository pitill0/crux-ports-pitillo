# Description: programs and scripts for creating debuginfo
# URL: https://sourceware.org/debugedit/
# Maintainer: Victor Martinez, pitillo at crux-arm dot nu 
# Depends on: xxhash help2man gdb

name=debugedit
version=5.3
release=1
source=(https://sourceware.org/ftp/debugedit/${version}/${name}-${version}.tar.xz
        remove-dwz.patch)

build() {
  cd ${name}-${version}
  patch -Np1 < "$SRC/remove-dwz.patch"
  autoreconf -fiv
  ./configure --prefix=/usr

  make
  make DESTDIR="${PKG}" install
}

