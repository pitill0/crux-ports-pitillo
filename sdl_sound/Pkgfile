# Description: A library for decoding various sound formats.
# URL: http://www.icculus.org/SDL_sound/
# Packager: Aaron Marks, nymacro at gmail dot com
# Maintainer: Victor Martinez, pitillo at crux-arm dot nu
# Depends on: libsdl libmikmod
# Nice to have: smpeg

name=sdl_sound
version=2.0.4
release=1

source=(https://github.com/icculus/SDL_sound/releases/download/v${version}/SDL2_sound-$version.tar.gz)

build() {
#  cd SDL2_sound-$version
  cmake -S SDL2_sound-$version -B build \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_INSTALL_LIBDIR=lib \
        -Wno-dev

  cmake --build build -j ${JOBS:-1}
  DESTDIR=$PKG cmake --install build
}
