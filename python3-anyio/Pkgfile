# Description: High-level concurrency and networking framework for Python
# URL: https://github.com/agronholm/anyio
# Maintainer: Victor Martinez, pitillo at crux dot nu
# Depends on: python3-idna python3-typing_extensions python3-setuptools-scm

name=python3-anyio
version=4.14.2
release=1
source=(https://files.pythonhosted.org/packages/source/a/anyio/anyio-${version}.tar.gz)

build() {
  cd anyio-${version}

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --compile-bytecode 2 \
    --destdir=${PKG} dist/*.whl
}
